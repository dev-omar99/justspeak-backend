# ==============================================================================
# JustSpeak Production Backend Environment Variables (.env.example)
# ==============================================================================

# 1. Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:0000@127.0.0.1:2000/justspeak_db?schema=public"

# 2. Server Configuration & CORS
PORT=4000
NODE_ENV="production"
CORS_ORIGINS="http://localhost:3000,https://justspeak.vercel.app"

# 3. Security & JWT
JWT_SECRET="replace-with-strong-production-secret-key"
# The single administrator account. Only this email can access /admin endpoints.
ADMIN_EMAIL="owner@example.com"
# Optional: set to "true" to expose the Swagger docs at /api/docs even in production (off in production by default).
ENABLE_SWAGGER=
# Optional: "false" disables the development fallback that echoes a signup OTP when no email provider is configured.
ALLOW_DEV_OTP=

# 4. Google OAuth 2.0 (Must match frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# 5. Twilio SMS Configuration (Optional)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"

# 6. Resend Email API (preferred on Railway - outbound SMTP is blocked there)
# Create an API key at https://resend.com/api-keys (free tier).
# Without a verified domain, Resend only sends from onboarding@resend.dev
# and only to the account owner's own address; verify a domain + set
# RESEND_FROM to email arbitrary users.
RESEND_API_KEY=""
RESEND_FROM="JustSpeak <onboarding@resend.dev>"

# 7. SMTP Email Configuration (Gmail App Password) - fallback when RESEND_API_KEY is empty
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-official-email@gmail.com"
SMTP_PASS="your-16-digit-google-app-password"
SMTP_FROM="JustSpeak <your-official-email@gmail.com>"

# 7. Dual Payment Gateways (Paymob Egypt/MENA + Stripe Global USD)
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 8. WebRTC / Video Fallback (Daily.co)
DAILY_API_KEY=""

# 9. AI Partner (voice conversation section) - all optional, feature stays OFF until enabled
JUSTSPEAK_AI_ENABLED="false"
DEEPGRAM_API_KEY=""
# Learners pause mid-sentence: longer endpointing keeps turns whole (ms)
DEEPGRAM_ENDPOINTING_MS="1000"
DEEPGRAM_UTTERANCE_END_MS="2000"
ANTHROPIC_API_KEY=""
ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"
ELEVENLABS_VOICE_SARA=""
ELEVENLABS_VOICE_ADAMS=""
ELEVENLABS_VOICE_RACHEL=""
ELEVENLABS_VOICE_SAM=""
AI_PARTNER_LIVE_MODEL="claude-haiku-4-5"
AI_PARTNER_FEEDBACK_MODEL="claude-sonnet-4-5"
AI_PARTNER_PLACEMENT_MODEL="claude-opus-4-5"
AI_PARTNER_FREE_SESSIONS="5"
AI_PARTNER_PLUS_DAILY_SESSIONS="10"
AI_PARTNER_ELITE_DAILY_SESSIONS="30"
AI_PARTNER_MAX_SESSION_MINUTES="20"
# Optional tuning (defaults live in src/ai-partner/ai-partner.config.ts)
AI_PARTNER_TARGET_MINUTES=
AI_PARTNER_MAX_CONCURRENT_LIVE=
AI_PARTNER_RECONNECT_GRACE_MS=
AI_PARTNER_COMMIT_FALLBACK_MS="4000"
AI_PARTNER_REPHRASE_MODEL=""
AI_PARTNER_MIN_REPORT_SPEECH_SEC="60"
# Optional: run the live conversation loop on an OpenAI-compatible provider
# (e.g. Groq free tier). Leave BASE_URL empty to stay on Anthropic/Claude.
AI_PARTNER_LIVE_BASE_URL=""
AI_PARTNER_LIVE_API_KEY=""
# Optional: real phoneme-level pronunciation scoring (Azure Speech). Off by default.
AZURE_SPEECH_PRONUNCIATION_ENABLED="false"
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"
AZURE_SPEECH_MAX_CONCURRENT="4"

# Optional: route signup codes for NEW emails to this owner address (gatekeeper). Needs RESEND_API_KEY.
OTP_OWNER_EMAIL=

# Optional: extra accounts (comma-separated emails) that may preview draft lessons. Empty = admin only.
CURRICULUM_PREVIEW_EMAILS=

# Curriculum switches (the new programmes ship as hidden drafts):
# - CURRICULUM_ADMIN_PREVIEW=true lets the ADMIN_EMAIL account (and CURRICULUM_PREVIEW_EMAILS) see the drafts.
# - CURRICULUM_ENABLED=true shows every draft to every learner. Leave unset until the content is approved.
# - HIDE_LEGACY_PROGRAMMES=true hides the old roleplay lists, only for viewers who already have new programmes.
CURRICULUM_ADMIN_PREVIEW=
CURRICULUM_ENABLED=
HIDE_LEGACY_PROGRAMMES=

# Optional: recordings storage. Empty = local disk mode. Set the S3_* values for an S3-compatible bucket.
AI_PARTNER_RECORDINGS_DIR=
AI_PARTNER_RECORDINGS_MAX_BYTES=
AI_PARTNER_RECORDINGS_URL_TTL_SEC=
AI_PARTNER_RECORDINGS_S3_ENDPOINT=
AI_PARTNER_RECORDINGS_S3_BUCKET=
AI_PARTNER_RECORDINGS_S3_REGION=
AI_PARTNER_RECORDINGS_S3_ACCESS_KEY_ID=
AI_PARTNER_RECORDINGS_S3_SECRET_ACCESS_KEY=
AI_PARTNER_RECORDINGS_S3_PUBLIC_BASE_URL=

# Optional: used by the translate-word helper in the Users module.
GEMINI_API_KEY=
