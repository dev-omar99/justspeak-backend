generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  emailVerified   Boolean   @default(false)
  phone           String?   @unique
  countryCode     String?
  password        String
  name            String?
  country         String?
  englishLevel    String?   @default("Intermediate")
  isAdmin         Boolean   @default(false)
  avatarUrl       String?
  bio             String?
  ticketsLeft     Int       @default(5)
  lastTicketReset DateTime  @default(now())
  tribeId         Int?
  lastTribeBonus  DateTime?
  createdAt       DateTime  @default(now())

  givenFeedbacks       SessionFeedback[]     @relation("GivenFeedback")
  receivedFeedbacks    SessionFeedback[]     @relation("ReceivedFeedback")
  blockedUsers         UserBlock[]           @relation("UserBlocks")
  blockedByUsers       UserBlock[]           @relation("BlockedUsers")
  buddies              UserBuddy[]           @relation("UserBuddies")
  buddyOf              UserBuddy[]           @relation("UserBuddyOf")
  subscription         UserSubscription?
  aiFreeTurnUsage      AiFreeTurnUsage[]
  partnerMemos         PartnerMemo[]
  academyProgress      AcademyProgress?
  aiPartnerSessions    AiPartnerSession[]
  aiPartnerQuotaOffset AiPartnerQuotaOffset?

  @@index([phone])
  @@index([country])
  @@index([englishLevel])
  @@index([tribeId])
  @@index([createdAt])
}

model UserBuddy {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserBuddies", fields: [userId], references: [id], onDelete: Cascade)
  buddyId   String
  buddy     User     @relation("UserBuddyOf", fields: [buddyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, buddyId])
  @@index([userId])
  @@index([buddyId])
}

model Session {
  id             String            @id @default(uuid())
  roomName       String            @unique
  topic          String?
  participantIds String[]          @default([])
  createdAt      DateTime          @default(now())
  feedbacks      SessionFeedback[]

  @@index([createdAt])
}

model SessionFeedback {
  id            String        @id @default(uuid())
  sessionId     String
  session       Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  giverId       String
  giver         User          @relation("GivenFeedback", fields: [giverId], references: [id], onDelete: Cascade)
  receiverId    String
  receiver      User          @relation("ReceivedFeedback", fields: [receiverId], references: [id], onDelete: Cascade)
  levelFeedback LevelFeedback
  partnerRating PartnerRating
  compliments   String[]      @default([])
  createdAt     DateTime      @default(now())

  @@unique([sessionId, giverId])
  @@index([giverId, receiverId])
  @@index([receiverId])
  @@index([giverId])
  @@index([partnerRating])
  @@index([createdAt])
}

model UserBlock {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserBlocks", fields: [userId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, blockedId])
  @@index([userId])
  @@index([blockedId])
}

enum LevelFeedback {
  HIGHER
  SAME
  LOWER
}

enum PartnerRating {
  LIKED
  NEUTRAL
  BLOCKED
}

model OtpCode {
  id         String   @id @default(uuid())
  identifier String
  code       String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([code])
}

model UserSubscription {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planTier        String   @default("FREE")
  aiTokensBalance Int      @default(0)
  updatedAt       DateTime @updatedAt
}

/// Free-tier AI Coach turns used per user per UTC day (was an in-memory Map, lost on every restart).
model AiFreeTurnUsage {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey String
  count   Int    @default(0)

  @@id([userId, dateKey])
}

model PartnerMemo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerId String
  memo      String
  updatedAt DateTime @updatedAt

  @@unique([userId, partnerId])
  @@index([userId])
}

model AiPartnerSession {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        String
  personaId   String
  fieldId     String?
  lessonId    String?
  roleplayId  String?
  level       String
  status      String               @default("active")
  startedAt   DateTime             @default(now())
  endedAt     DateTime?
  durationSec Int                  @default(0)
  transcript  Json                 @default("[]")
  facts       Json                 @default("[]")
  metrics     Json                 @default("{}")
  report      Json?
  reportModel String?
  createdAt   DateTime             @default(now())
  recordings  AiPartnerRecording[]

  @@index([userId, createdAt])
}

model AcademyProgress {
  userId                    String   @id
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cefrLevel                 String   @default("B1")
  placementCompleted        Boolean  @default(false)
  dailySpeakingGoalMins     Int      @default(21)
  learnedWordIds            String[] @default([])
  completedLessonIds        String[] @default([])
  completedReadingIds       String[] @default([])
  completedListeningIds     String[] @default([])
  completedShadowingIds     String[] @default([])
  completedPronunciationIds String[] @default([])
  dailyCompletedTaskIds     String[] @default([])
  dailyDateKey              String   @default("")
  scores                    Json
  updatedAt                 DateTime @updatedAt
}

model AiPartnerQuotaOffset {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offset    Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AiPartnerRecording {
  id         String           @id @default(uuid())
  sessionId  String
  session    AiPartnerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  kind       String
  status     String           @default("pending")
  storageKey String?
  mimeType   String           @default("")
  bytes      Int              @default(0)
  durationMs Int              @default(0)
  position   Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([sessionId, position])
  @@index([userId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminEmail String
  action     String
  targetType String
  targetId   String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminEmail])
}
